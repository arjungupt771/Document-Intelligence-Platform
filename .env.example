# ============================================================
# Document Intelligence Platform
# Environment configuration template
# ============================================================

# ----------------------------
# Database
# ----------------------------

# Required. Never commit a real credential.
DATABASE_URL=postgresql+psycopg2://<username>:<password>@<host>:5432/<database>

# SQLAlchemy configuration
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

QDRANT_TIMEOUT=30
# ----------------------------
# API Authentication
# ----------------------------

# Required when protected API routes are enabled.
# Generate a strong random value for real deployments.

API_AUTH_KEY=<generate-a-strong-secret>
METRICS_AUTH_KEY=<generate-a-strong-secret>

# ----------------------------
# Qdrant
# ----------------------------

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=document_chunks
QDRANT_DISTANCE=Cosine
EMBEDDING_DIM=384


# ----------------------------
# LLM
# ----------------------------

LLM_URL=https://api.groq.com/openai/v1
LLM_ENDPOINT=/chat/completions
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT=30.0
LLM_API_KEY=<secret>


# ----------------------------
# Drift Detection
# ----------------------------

DRIFT_THRESHOLD_MODERATE=0.1
DRIFT_THRESHOLD_SIGNIFICANT=0.2


# ----------------------------
# Testing
# ----------------------------

# Only required when running PostgreSQL persistence
# integration tests explicitly.
TEST_DATABASE_URL=


# ----------------------------
# Rate limiting (optional)
# ----------------------------
# If unset, rate limiting falls back to in-process (fine for single instance,
# NOT correct across multiple workers/replicas).

# ----------------------------
# Deployment
# ----------------------------
APP_ENV=production
IMAGE_REGISTRY=ghcr.io/yourorg
IMAGE_TAG=latest

# ----------------------------
# Postgres (compose)
# ----------------------------
POSTGRES_USER=docint
POSTGRES_PASSWORD=<generate-a-strong-secret>
POSTGRES_DB=document_intelligence

# ----------------------------
# Rate limiting (see 16.14)
# ----------------------------
REDIS_URL=redis://redis:6379